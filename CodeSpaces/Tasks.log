Ran terminal command:  cd /workspaces/codespaces-blank && sudo apt-get install -y --no-install-recommends linux-image-unsigned-6.8.0-31-generic && mkdir -p tinyiso && cat > tinyiso/build-tiny-iso.sh <<'EOF'
#!/bin/bash
set -euo pipefail
WORKDIR="/workspaces/codespaces-blank/tinyiso"
ROOT="$WORKDIR/rootfs"
ISOROOT="$WORKDIR/iso"
OUT="$WORKDIR/tiny-linux.iso"
KERNEL="/boot/vmlinuz-6.8.0-31-generic"

rm -rf "$ROOT" "$ISOROOT" "$OUT"
mkdir -p "$ROOT"/bin "$ROOT"/dev "$ROOT"/proc "$ROOT"/sys "$ROOT"/etc "$ROOT"/usr/bin "$ROOT"/usr/sbin "$ISOROOT"/boot/grub

cp /bin/busybox "$ROOT/bin/busybox"
chmod 0755 "$ROOT/bin/busybox"
ln -sf /bin/busybox "$ROOT/bin/sh"
ln -sf /bin/busybox "$ROOT/bin/init"

mknod -m 0666 "$ROOT/dev/null" c 1 3
mknod -m 0666 "$ROOT/dev/console" c 5 1

cat > "$ROOT/init" <<'INIT'
#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
echo "Tiny Linux booted"
exec /bin/sh
INIT
chmod 0755 "$ROOT/init"

cp "$KERNEL" "$ISOROOT/boot/vmlinuz"
( cd "$ROOT" && find . | cpio -o -H newc | gzip -9 > "$ISOROOT/boot/initrd.img" )

cat > "$ISOROOT/boot/grub/grub.cfg" <<'GRUB'
set default=0
set timeout=0
menuentry "Tiny Linux" {
  linux /boot/vmlinuz console=tty0 console=ttyS0 rdinit=/init
  initrd /boot/initrd.img
}
GRUB

grub-mkrescue -o "$OUT" "$ISOROOT" >/tmp/grub-mkrescue.log 2>&1

ls -lh "$OUT"
stat -c '%s bytes' "$OUT"
EOF
chmod +x tinyiso/build-tiny-iso.sh
./tinyiso/build-tiny-iso.sh


